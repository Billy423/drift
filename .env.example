# drift — environment configuration. Export these; nothing here reads a .env file.
# All have local defaults that match docker-compose.yml.

# Postgres: the issue lifecycle, the scan history and the run journal.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# Celery broker — the queue between `drift scan --async` and the workers.
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend — task status and return values, queryable by task id.
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Anthropic API key. Required by `drift check` and `drift scan`, and it costs money.
# Spend is capped per run by `--budget`; see the README for the no-key failure mode.

# Under `--async` the key must be in the cells worker's environment, not the CLI's:
# the frame is a task, the cells are broker messages, and neither constructs a client.
ANTHROPIC_API_KEY=sk-ant-...
